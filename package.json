{
  "name": "tasks",
  "version": "1.0.0",
  "private": true,
  "description": "A private, offline-first task planner built with React, Redux Toolkit and Vite.",
  "homepage": "https://tasks.sacrificed.me",
  "license": "MIT",
  "author": "Illia Movchko (https://github.com/sacrificed666)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sacrificed666/tasks.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:text": "node scripts/check-text.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "flags": "node scripts/sync-flags.mjs",
    "check": "npm run lint && npm run lint:text && npm run format:check && npm run typecheck && npm run test:run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "country-flag-icons": "^1.6.20",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sass-embedded": "^1.105.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "monitor": {
    "paths": [
      "/",
      "/.well-known/security.txt",
      "/sw.js",
      "/robots.txt",
      "/sitemap.xml"
    ],
    "pages": [
      "/"
    ]
  }
}
